{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tacktalkregatta",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  // Drizzle ukladá migrácie do ./drizzle (nie do predvoleného ./migrations).
  "migrations_dir": "drizzle",
  // D1 databáza pre CRM. `database_id` doplň po `wrangler d1 create tacktalkregatta`
  // (príkaz vypíše skutočné ID, ktoré sem vložíš). `binding` musí zostať "DB".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tacktalkregatta",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create"
    }
  ]
  // Tajné premenné (RESEND_API_KEY, EMAIL_FROM, RESEND_WEBHOOK_SECRET,
  // ADMIN_CREDENTIALS_JSON, ADMIN_SESSION_SECRET, ADMIN_RESET_SECRET,
  // UNSUBSCRIBE_SECRET, TURNSTILE_SECRET_KEY) sa nastavujú cez
  // `wrangler secret put NAZOV`, nikdy nie tu.
}
