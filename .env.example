# E-mailové kampane. Skutočné hodnoty patria do tajných premenných hostingu.
RESEND_API_KEY=
EMAIL_FROM=Tack & Talk Regatta <info@tacktalkregatta.com>
EMAIL_REPLY_TO=info@tacktalkregatta.com
RESEND_WEBHOOK_SECRET=

# Admin heslá sa ukladajú iba ako PBKDF2 hashe v tajných premenných hostingu.
# Vygeneruj: `npm run admin:hash -- "email" "Meno"`
ADMIN_CREDENTIALS_JSON=
# Podpis 8-hodinovej admin relácie (min. 32 znakov). Vygeneruj: `npm run admin:secrets`
ADMIN_SESSION_SECRET=
# Podpis jednorazového odkazu na obnovu hesla (min. 32 znakov).
ADMIN_RESET_SECRET=
# Podpis odhlasovacích odkazov v hromadných e-mailoch (min. 32 znakov).
UNSUBSCRIBE_SECRET=

# Cloudflare Turnstile — ochrana prihlásenia a verejného formulára pred botmi.
# Ak nie sú nastavené, overenie sa preskočí (vhodné pre lokálny vývoj).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Verejná URL (canonical, OG, sitemap) a povolenie indexovania pri spustení.
NEXT_PUBLIC_SITE_URL=https://tacktalkregatta.com
NEXT_PUBLIC_ALLOW_INDEXING=false

# Zastarané: pôvodná obnova hesla viazaná na prihlásenie cez ChatGPT (Sites).
# Na vlastnom Cloudflare hostingu sa nepoužíva — nahradené odkazom cez e-mail.
ADMIN_RECOVERY_IDENTITIES_JSON=
